{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@academy/design-tokens": ["../../packages/design-tokens/src"],
      "@academy/shared-types": ["../../packages/shared-types/src"],
      "@academy/learning-engine": ["../../packages/learning-engine/src"],
      "@academy/visualizations": ["../../packages/visualizations/src"],
      "@academy/browser-ml": ["../../packages/browser-ml/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
