# Environment variables template for AI Engineering Academy
# Copy to .env and adjust as necessary

# PostgreSQL
POSTGRES_DB=ai_academy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password_in_production
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Backend Security
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client API
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000
