FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

COPY . /app

RUN uv venv /app/.venv && \
    uv pip install --python /app/.venv \
    fastapi "uvicorn[standard]" "sqlalchemy[asyncio]" asyncpg alembic psycopg2-binary \
    pgvector pydantic pydantic-settings email-validator redis "python-jose[cryptography]" \
    passlib bcrypt python-multipart httpx numpy pandas scipy scikit-learn jsonschema torch torchvision

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

EXPOSE 8000

CMD ["sh", "-c", "python -m backend.app.core.init_db && uvicorn backend.app.main:app --host 0.0.0.0 --port 8000"]
